{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sodeck/workbench-ui-v1",
  "x-methods": {
    "plugins.metadata.list": "Empty",
    "workbench.contributions.v2": "Empty",
    "views.badge.set": "Badge",
    "ui.dialog.open": "DialogOpen",
    "ui.dialog.ready": "DialogSession",
    "ui.dialog.complete": "DialogComplete",
    "ui.dialog.close": "DialogSession",
    "ui.dialog.result": "DialogSession"
  },
  "x-results": {
    "plugins.metadata.list": "PluginMetadataResult",
    "workbench.contributions.v2": "WorkbenchContributionsV2",
    "views.badge.set": "Ok",
    "ui.dialog.open": "DialogResult",
    "ui.dialog.ready": "DialogResult",
    "ui.dialog.complete": "DialogResult",
    "ui.dialog.close": "DialogResult",
    "ui.dialog.result": "DialogResult"
  },
  "x-events": {
    "ui.dialog.closed": "DialogResult",
    "ui.dialog.cancelRequested": "DialogCancel",
    "views.badge.changed": "BadgeEvent"
  },
  "$defs": {
    "Empty": {
      "type": "object",
      "additionalProperties": false,
      "properties": {},
      "required": []
    },
    "Badge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "viewId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999
        }
      },
      "required": [
        "viewId",
        "count"
      ]
    },
    "DialogOpen": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "dialogId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "initialState": {}
      },
      "required": [
        "requestId",
        "dialogId",
        "initialState"
      ]
    },
    "DialogSession": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "sessionId"
      ]
    },
    "DialogComplete": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "result": {}
      },
      "required": [
        "sessionId",
        "result"
      ]
    },
    "PluginMetadataResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "plugins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PluginMetadata"
          },
          "maxItems": 512
        }
      },
      "required": [
        "plugins"
      ]
    },
    "WorkbenchContributionsV2": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "plugins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PresentedPlugin"
          },
          "maxItems": 512
        },
        "badges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Badge"
          },
          "maxItems": 4096
        }
      },
      "required": [
        "plugins",
        "badges"
      ]
    },
    "Ok": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ok": {
          "enum": [
            true
          ]
        }
      },
      "required": [
        "ok"
      ]
    },
    "DialogResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "status": {
          "enum": [
            "opening",
            "open",
            "completed",
            "cancelled",
            "failed"
          ]
        },
        "result": {},
        "error": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "required": [
            "code",
            "message"
          ]
        }
      },
      "required": [
        "sessionId",
        "status"
      ]
    },
    "DialogCancel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "sessionId"
      ]
    },
    "BadgeEvent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "viewId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999
        }
      },
      "required": [
        "viewId",
        "count"
      ]
    },
    "PluginMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pluginId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "activeVersion": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "pendingVersion": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "pendingDisplayName": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "pluginId",
        "activeVersion",
        "pendingVersion",
        "error",
        "displayName",
        "pendingDisplayName"
      ]
    },
    "PresentedPlugin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pluginId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CommandDeclaration"
          },
          "maxItems": 512
        },
        "views": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PresentedView"
          },
          "maxItems": 512
        },
        "presentation": {
          "$ref": "#/$defs/Presentation"
        }
      },
      "required": [
        "pluginId",
        "displayName",
        "commands",
        "views",
        "presentation"
      ]
    },
    "CommandDeclaration": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "title": {
          "type": "string"
        },
        "scope": {
          "enum": [
            "server",
            "global",
            "view"
          ]
        },
        "primary": {
          "type": "boolean"
        },
        "input": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "text"
              ]
            },
            "key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "initial": {
              "enum": [
                "viewTitle"
              ]
            },
            "minLength": {
              "type": "integer",
              "minimum": 0,
              "maximum": 256
            },
            "maxLength": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            }
          },
          "required": [
            "kind",
            "key",
            "label",
            "initial",
            "minLength",
            "maxLength"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "title",
        "scope",
        "primary"
      ],
      "additionalProperties": false
    },
    "PresentedView": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "scope": {
          "enum": [
            "server",
            "global"
          ]
        },
        "supportedHosts": {
          "type": "array",
          "items": {
            "enum": [
              "dock",
              "tab",
              "window"
            ]
          },
          "maxItems": 3
        },
        "dockEdges": {
          "type": "array",
          "items": {
            "enum": [
              "left",
              "right",
              "bottom"
            ]
          },
          "maxItems": 3
        },
        "multiple": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "title",
        "scope",
        "supportedHosts",
        "dockEdges",
        "multiple"
      ]
    },
    "Presentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ToolContribution"
          },
          "maxItems": 32
        },
        "tabCreate": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TabCreateContribution"
          },
          "maxItems": 1
        },
        "dialogs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DialogDeclaration"
          },
          "maxItems": 16
        }
      },
      "required": [
        "tools",
        "tabCreate",
        "dialogs"
      ]
    },
    "ToolContribution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "viewType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "commandId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "edge": {
          "enum": [
            "left",
            "right"
          ]
        },
        "icon": {
          "enum": [
            "folder",
            "arrow-left-right",
            "terminal",
            "layout-panel"
          ]
        },
        "defaultWidth": {
          "type": "integer",
          "minimum": 260,
          "maximum": 480
        }
      },
      "required": [
        "viewType",
        "commandId",
        "edge",
        "icon",
        "defaultWidth"
      ]
    },
    "TabCreateContribution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commandId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "icon": {
          "enum": [
            "plus"
          ]
        }
      },
      "required": [
        "commandId",
        "icon"
      ]
    },
    "DialogDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "width": {
          "type": "integer",
          "minimum": 320,
          "maximum": 960
        },
        "height": {
          "type": "integer",
          "minimum": 240,
          "maximum": 960
        }
      },
      "required": [
        "id",
        "title",
        "width",
        "height"
      ]
    }
  }
}
