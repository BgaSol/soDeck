{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ConnectionRoute": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "direct"
              ]
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "sshJump"
              ]
            },
            "jumpServerId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "required": [
            "kind",
            "jumpServerId"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Server": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "username": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "authType": {
          "enum": [
            "password",
            "key"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "hasSecret": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "host",
        "port",
        "username",
        "authType",
        "revision",
        "hasSecret"
      ],
      "additionalProperties": false
    },
    "RouteServer": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "username": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "authType": {
          "enum": [
            "password",
            "key"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "hasSecret": {
          "type": "boolean"
        },
        "connectionRoute": {
          "$ref": "#/$defs/ConnectionRoute"
        }
      },
      "required": [
        "id",
        "name",
        "host",
        "port",
        "username",
        "authType",
        "revision",
        "hasSecret",
        "connectionRoute"
      ],
      "additionalProperties": false
    },
    "CreateServer": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "username": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "authType": {
          "enum": [
            "password",
            "key"
          ]
        },
        "connectionRoute": {
          "$ref": "#/$defs/ConnectionRoute"
        }
      },
      "required": [
        "name",
        "host",
        "username",
        "connectionRoute"
      ],
      "additionalProperties": false
    },
    "UpdateServer": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "username": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "authType": {
          "enum": [
            "password",
            "key"
          ]
        },
        "connectionRoute": {
          "$ref": "#/$defs/ConnectionRoute"
        },
        "serverId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "name",
        "host",
        "username",
        "connectionRoute",
        "serverId",
        "expectedRevision"
      ],
      "additionalProperties": false
    },
    "ServerId": {
      "type": "object",
      "properties": {
        "serverId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "serverId"
      ],
      "additionalProperties": false
    },
    "ListRequest": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "ServerList": {
      "type": "object",
      "properties": {
        "servers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RouteServer"
          },
          "maxItems": 10000
        }
      },
      "required": [
        "servers"
      ],
      "additionalProperties": false
    },
    "RouteNode": {
      "type": "object",
      "properties": {
        "serverId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "username": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "authType": {
          "enum": [
            "password",
            "key"
          ]
        },
        "configRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "role": {
          "enum": [
            "jump",
            "target"
          ]
        }
      },
      "required": [
        "serverId",
        "name",
        "host",
        "port",
        "username",
        "authType",
        "configRevision",
        "role"
      ],
      "additionalProperties": false
    },
    "RouteSummary": {
      "type": "object",
      "properties": {
        "targetServerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "routeRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RouteNode"
          },
          "minItems": 1,
          "maxItems": 2
        }
      },
      "required": [
        "targetServerId",
        "routeRevision",
        "nodes"
      ],
      "additionalProperties": false
    },
    "RouteRequest": {
      "type": "object",
      "properties": {
        "serverId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "workspaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "serverId",
        "workspaceId"
      ],
      "additionalProperties": false
    },
    "Error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "details": {}
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "Bridge": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "active",
            "closed",
            "failed"
          ]
        },
        "upstreamBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "downstreamBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "peakBufferedBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "state",
        "upstreamBytes",
        "downstreamBytes",
        "peakBufferedBytes"
      ],
      "additionalProperties": false
    },
    "RunningRoute": {
      "type": "object",
      "properties": {
        "connectionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "route": {
          "$ref": "#/$defs/RouteSummary"
        },
        "state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "configurationChanged": {
          "type": "boolean"
        },
        "bridge": {
          "anyOf": [
            {
              "$ref": "#/$defs/Bridge"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "connectionId",
        "generation",
        "route",
        "state",
        "configurationChanged",
        "bridge"
      ],
      "additionalProperties": false
    },
    "RouteAttempt": {
      "type": "object",
      "properties": {
        "route": {
          "$ref": "#/$defs/RouteSummary"
        },
        "hopIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "stage": {
          "enum": [
            "connect",
            "forward",
            "handshake",
            "verify",
            "authenticate",
            "active",
            "failed",
            "canceled"
          ]
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/Error"
            },
            {
              "type": "null"
            }
          ]
        },
        "updated": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "route",
        "hopIndex",
        "stage",
        "error",
        "updated"
      ],
      "additionalProperties": false
    },
    "RouteStatus": {
      "type": "object",
      "properties": {
        "saved": {
          "$ref": "#/$defs/RouteSummary"
        },
        "running": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RunningRoute"
          },
          "maxItems": 10000
        },
        "attempt": {
          "anyOf": [
            {
              "$ref": "#/$defs/RouteAttempt"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "saved",
        "running",
        "attempt"
      ],
      "additionalProperties": false
    },
    "ChallengeRequest": {
      "type": "object",
      "properties": {
        "challengeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "targetServerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "challengeId",
        "targetServerId"
      ],
      "additionalProperties": false
    },
    "Challenge": {
      "type": "object",
      "properties": {
        "server": {
          "$ref": "#/$defs/Server"
        },
        "targetServerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "workspaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "operationId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "route": {
          "$ref": "#/$defs/RouteSummary"
        },
        "role": {
          "enum": [
            "jump",
            "target"
          ]
        },
        "hopIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "hopCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        }
      },
      "required": [
        "server",
        "targetServerId",
        "workspaceId",
        "operationId",
        "route",
        "role",
        "hopIndex",
        "hopCount"
      ],
      "additionalProperties": false
    },
    "ResourceRoute": {
      "type": "object",
      "properties": {
        "connectionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "workspaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "route": {
          "$ref": "#/$defs/RouteSummary"
        },
        "holders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 1024
        }
      },
      "required": [
        "connectionId",
        "workspaceId",
        "generation",
        "state",
        "route",
        "holders"
      ],
      "additionalProperties": false
    },
    "RouteResources": {
      "type": "object",
      "properties": {
        "connections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResourceRoute"
          },
          "maxItems": 64
        }
      },
      "required": [
        "connections"
      ],
      "additionalProperties": false
    },
    "Dependencies": {
      "type": "object",
      "properties": {
        "saved": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Server"
          },
          "maxItems": 10000
        },
        "running": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResourceRoute"
          },
          "maxItems": 64
        }
      },
      "required": [
        "saved",
        "running"
      ],
      "additionalProperties": false
    }
  },
  "x-methods": {
    "servers.routes.list": "ListRequest",
    "servers.routes.get": "ServerId",
    "servers.routes.create": "CreateServer",
    "servers.routes.update": "UpdateServer",
    "connections.route.get": "RouteRequest",
    "auth.challenge.get": "ChallengeRequest",
    "connections.routes.list": "ListRequest",
    "servers.routes.dependencies": "ServerId"
  },
  "x-results": {
    "servers.routes.list": "ServerList",
    "servers.routes.get": "RouteServer",
    "servers.routes.create": "RouteServer",
    "servers.routes.update": "RouteServer",
    "connections.route.get": "RouteStatus",
    "auth.challenge.get": "Challenge",
    "connections.routes.list": "RouteResources",
    "servers.routes.dependencies": "Dependencies"
  }
}
