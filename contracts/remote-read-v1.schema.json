{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sodeck:remote-read:v1",
  "$defs": {
    "WorkspaceScope": {
      "type": "object",
      "properties": {
        "workspaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "workspaceGeneration": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "workspaceId",
        "workspaceGeneration"
      ],
      "additionalProperties": false
    },
    "RemotePath": {
      "type": "object",
      "properties": {
        "bytesBase64": {
          "type": "string",
          "minLength": 1,
          "maxLength": 21848
        }
      },
      "required": [
        "bytesBase64"
      ],
      "additionalProperties": false
    },
    "Attributes": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "directory",
            "file",
            "symlink",
            "fifo",
            "characterDevice",
            "blockDevice",
            "socket",
            "unknown"
          ]
        },
        "size": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]+$",
              "minLength": 1,
              "maxLength": 20
            },
            {
              "type": "null"
            }
          ]
        },
        "mtime": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]+$",
              "minLength": 1,
              "maxLength": 20
            },
            {
              "type": "null"
            }
          ]
        },
        "atime": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]+$",
              "minLength": 1,
              "maxLength": 20
            },
            {
              "type": "null"
            }
          ]
        },
        "permissions": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "uid": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "gid": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "size",
        "mtime",
        "atime",
        "permissions",
        "uid",
        "gid"
      ],
      "additionalProperties": false
    },
    "Operation": {
      "type": "object",
      "properties": {
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "operationId"
      ],
      "additionalProperties": false
    },
    "Closed": {
      "type": "object",
      "properties": {
        "closed": {
          "type": "boolean"
        }
      },
      "required": [
        "closed"
      ],
      "additionalProperties": false
    },
    "Lease": {
      "type": "object",
      "properties": {
        "leaseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "connectionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "leaseId",
        "connectionId",
        "generation"
      ],
      "additionalProperties": false
    },
    "Entry": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/RemotePath"
        },
        "attributes": {
          "$ref": "#/$defs/Attributes"
        }
      },
      "required": [
        "name",
        "attributes"
      ],
      "additionalProperties": false
    },
    "FilesOpenDirectoryRequest": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "#/$defs/WorkspaceScope"
        },
        "leaseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "connectionGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30000
        },
        "path": {
          "$ref": "#/$defs/RemotePath"
        }
      },
      "required": [
        "scope",
        "leaseId",
        "connectionGeneration",
        "operationId",
        "path"
      ],
      "additionalProperties": false
    },
    "FilesOpenDirectoryResult": {
      "type": "object",
      "properties": {
        "directoryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "cursor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "directoryId",
        "cursor"
      ],
      "additionalProperties": false
    },
    "FilesOpenReadRequest": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "#/$defs/WorkspaceScope"
        },
        "leaseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "connectionGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30000
        },
        "path": {
          "$ref": "#/$defs/RemotePath"
        }
      },
      "required": [
        "scope",
        "leaseId",
        "connectionGeneration",
        "operationId",
        "path"
      ],
      "additionalProperties": false
    },
    "FilesOpenReadResult": {
      "type": "object",
      "properties": {
        "fileId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "fileId"
      ],
      "additionalProperties": false
    },
    "FilesStatRequest": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "#/$defs/WorkspaceScope"
        },
        "leaseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "connectionGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30000
        },
        "path": {
          "$ref": "#/$defs/RemotePath"
        },
        "followLinks": {
          "type": "boolean"
        }
      },
      "required": [
        "scope",
        "leaseId",
        "connectionGeneration",
        "operationId",
        "path"
      ],
      "additionalProperties": false
    },
    "FilesReadLinkRequest": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "#/$defs/WorkspaceScope"
        },
        "leaseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "connectionGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30000
        },
        "path": {
          "$ref": "#/$defs/RemotePath"
        }
      },
      "required": [
        "scope",
        "leaseId",
        "connectionGeneration",
        "operationId",
        "path"
      ],
      "additionalProperties": false
    },
    "FilesReadLinkResult": {
      "type": "object",
      "properties": {
        "path": {
          "$ref": "#/$defs/RemotePath"
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    },
    "FilesRealPathRequest": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "#/$defs/WorkspaceScope"
        },
        "leaseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "connectionGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30000
        },
        "path": {
          "$ref": "#/$defs/RemotePath"
        }
      },
      "required": [
        "scope",
        "leaseId",
        "connectionGeneration",
        "operationId",
        "path"
      ],
      "additionalProperties": false
    },
    "FilesRealPathResult": {
      "type": "object",
      "properties": {
        "path": {
          "$ref": "#/$defs/RemotePath"
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    },
    "FilesReadDirectoryRequest": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "#/$defs/WorkspaceScope"
        },
        "leaseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "connectionGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30000
        },
        "directoryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "cursor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxEntries": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        }
      },
      "required": [
        "scope",
        "leaseId",
        "connectionGeneration",
        "operationId",
        "directoryId",
        "cursor"
      ],
      "additionalProperties": false
    },
    "FilesReadDirectoryResult": {
      "type": "object",
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Entry"
          },
          "maxItems": 256
        },
        "nextCursor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "eof": {
          "type": "boolean"
        }
      },
      "required": [
        "entries",
        "nextCursor",
        "eof"
      ],
      "additionalProperties": false
    },
    "FilesReadRequest": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "#/$defs/WorkspaceScope"
        },
        "leaseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "connectionGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30000
        },
        "fileId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "offset": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "minLength": 1,
          "maxLength": 20
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        }
      },
      "required": [
        "scope",
        "leaseId",
        "connectionGeneration",
        "operationId",
        "fileId",
        "offset"
      ],
      "additionalProperties": false
    },
    "FilesReadResult": {
      "type": "object",
      "properties": {
        "bytesBase64": {
          "type": "string",
          "maxLength": 87384
        },
        "nextOffset": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "minLength": 1,
          "maxLength": 20
        },
        "eof": {
          "type": "boolean"
        }
      },
      "required": [
        "bytesBase64",
        "nextOffset",
        "eof"
      ],
      "additionalProperties": false
    },
    "FilesCloseRequest": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "#/$defs/WorkspaceScope"
        },
        "leaseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "connectionGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "fileId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "scope",
        "leaseId",
        "connectionGeneration",
        "fileId"
      ],
      "additionalProperties": false
    },
    "FilesCloseDirectoryRequest": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "#/$defs/WorkspaceScope"
        },
        "leaseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "connectionGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "directoryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "scope",
        "leaseId",
        "connectionGeneration",
        "directoryId"
      ],
      "additionalProperties": false
    },
    "ExecStartRequest": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "#/$defs/WorkspaceScope"
        },
        "leaseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "connectionGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30000
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "stdinBase64": {
          "type": "string",
          "maxLength": 87384
        },
        "maxOutputBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4194304
        }
      },
      "required": [
        "scope",
        "leaseId",
        "connectionGeneration",
        "operationId",
        "command"
      ],
      "additionalProperties": false
    },
    "ExecStartResult": {
      "type": "object",
      "properties": {
        "execId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "execId"
      ],
      "additionalProperties": false
    },
    "ExecFrame": {
      "type": "object",
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "stream": {
          "enum": [
            "stdout",
            "stderr"
          ]
        },
        "bytesBase64": {
          "type": "string",
          "maxLength": 87384
        },
        "length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        }
      },
      "required": [
        "sequence",
        "stream",
        "bytesBase64",
        "length"
      ],
      "additionalProperties": false
    },
    "ExecReadRequest": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "#/$defs/WorkspaceScope"
        },
        "leaseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "connectionGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "execId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "afterSequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 32768,
          "maximum": 65536
        }
      },
      "required": [
        "scope",
        "leaseId",
        "connectionGeneration",
        "execId"
      ],
      "additionalProperties": false
    },
    "ExecReadResult": {
      "type": "object",
      "properties": {
        "frames": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExecFrame"
          },
          "maxItems": 65536
        },
        "state": {
          "enum": [
            "starting",
            "running",
            "completed",
            "failed",
            "canceled"
          ]
        },
        "exitCode": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "truncated": {
          "type": "boolean"
        },
        "lastSequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "acknowledged": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "frames",
        "state",
        "exitCode",
        "reason",
        "truncated",
        "lastSequence",
        "acknowledged"
      ],
      "additionalProperties": false
    },
    "ExecAckRequest": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "#/$defs/WorkspaceScope"
        },
        "leaseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "connectionGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "execId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "scope",
        "leaseId",
        "connectionGeneration",
        "execId",
        "sequence"
      ],
      "additionalProperties": false
    },
    "ExecAckResult": {
      "type": "object",
      "properties": {
        "acknowledged": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "acknowledged"
      ],
      "additionalProperties": false
    },
    "ExecCancelRequest": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "#/$defs/WorkspaceScope"
        },
        "leaseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "connectionGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "execId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "scope",
        "leaseId",
        "connectionGeneration",
        "execId"
      ],
      "additionalProperties": false
    },
    "ExecCloseRequest": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "#/$defs/WorkspaceScope"
        },
        "leaseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "connectionGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "execId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "scope",
        "leaseId",
        "connectionGeneration",
        "execId"
      ],
      "additionalProperties": false
    },
    "RemoteError": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "details": {}
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "RemoteOperationsGetRequest": {
      "type": "object",
      "properties": {
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "operationId"
      ],
      "additionalProperties": false
    },
    "RemoteOperationsGetResult": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "enum": [
                "running"
              ]
            }
          },
          "required": [
            "state"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "enum": [
                "completed"
              ]
            },
            "result": {
              "anyOf": [
                {
                  "$ref": "#/$defs/FilesOpenDirectoryResult"
                },
                {
                  "$ref": "#/$defs/FilesOpenReadResult"
                },
                {
                  "$ref": "#/$defs/Attributes"
                },
                {
                  "$ref": "#/$defs/FilesReadLinkResult"
                },
                {
                  "$ref": "#/$defs/FilesRealPathResult"
                },
                {
                  "$ref": "#/$defs/FilesReadDirectoryResult"
                },
                {
                  "$ref": "#/$defs/FilesReadResult"
                },
                {
                  "$ref": "#/$defs/Closed"
                },
                {
                  "$ref": "#/$defs/ExecStartResult"
                },
                {
                  "$ref": "#/$defs/ExecReadResult"
                },
                {
                  "$ref": "#/$defs/ExecAckResult"
                },
                {
                  "$ref": "#/$defs/Lease"
                }
              ]
            }
          },
          "required": [
            "state",
            "result"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "enum": [
                "failed",
                "canceled"
              ]
            },
            "error": {
              "$ref": "#/$defs/RemoteError"
            }
          },
          "required": [
            "state",
            "error"
          ],
          "additionalProperties": false
        }
      ]
    },
    "RemoteOperationsForgetRequest": {
      "type": "object",
      "properties": {
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "operationId"
      ],
