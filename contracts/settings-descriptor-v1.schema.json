{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "SettingKey": {"type":"string","pattern":"^[a-zA-Z][a-zA-Z0-9._-]{0,79}$","maxLength":80},
    "SettingValue": {"anyOf":[{"type":"boolean"},{"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991},{"type":"string","maxLength":4096}]},
    "SettingCondition": {"type":"object","properties":{"key":{"$ref":"#/$defs/SettingKey"},"equals":{"$ref":"#/$defs/SettingValue"}},"required":["key","equals"],"additionalProperties":false},
    "SettingOption": {"type":"object","properties":{"value":{"type":"string","minLength":1,"maxLength":80},"label":{"type":"string","minLength":1,"maxLength":80}},"required":["value","label"],"additionalProperties":false},
    "SettingField": {
      "type":"object",
      "properties": {
        "key":{"$ref":"#/$defs/SettingKey"},"label":{"type":"string","minLength":1,"maxLength":80},
        "type":{"enum":["boolean","integer","text","enum"]},"default":{"$ref":"#/$defs/SettingValue"},
        "effect":{"enum":["immediate","newSession","restart"]},"description":{"type":"string","maxLength":512},
        "keywords":{"type":"array","maxItems":16,"items":{"type":"string","minLength":1,"maxLength":40}},
        "minimum":{"type":"integer"},"maximum":{"type":"integer"},"maxLength":{"type":"integer","minimum":1,"maximum":4096},
        "options":{"type":"array","minItems":1,"maxItems":64,"items":{"$ref":"#/$defs/SettingOption"}},
        "visibleWhen":{"$ref":"#/$defs/SettingCondition"},"enabledWhen":{"$ref":"#/$defs/SettingCondition"}
      },
      "required":["key","label","type","default","effect"],"additionalProperties":false
    },
    "SettingSection": {"type":"object","properties":{"id":{"$ref":"#/$defs/SettingKey"},"title":{"type":"string","minLength":1,"maxLength":80},"fields":{"type":"array","minItems":1,"maxItems":64,"items":{"$ref":"#/$defs/SettingField"}}},"required":["id","title","fields"],"additionalProperties":false},
    "SettingPage": {"type":"object","properties":{"id":{"$ref":"#/$defs/SettingKey"},"title":{"type":"string","minLength":1,"maxLength":80},"order":{"type":"integer","minimum":0,"maximum":100000},"schemaVersion":{"type":"integer","minimum":1,"maximum":2147483647},"sections":{"type":"array","minItems":1,"maxItems":8,"items":{"$ref":"#/$defs/SettingSection"}}},"required":["id","title","order","schemaVersion","sections"],"additionalProperties":false},
    "SettingsDescriptor": {"type":"object","properties":{"descriptorVersion":{"enum":[1]},"pluginId":{"type":"string","minLength":1,"maxLength":128},"pages":{"type":"array","minItems":1,"maxItems":4,"items":{"$ref":"#/$defs/SettingPage"}}},"required":["descriptorVersion","pluginId","pages"],"additionalProperties":false}
  }
}
