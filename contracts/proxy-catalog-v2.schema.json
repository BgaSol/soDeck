{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "Revision": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "maxLength": 19
    },
    "ProxyConfiguration": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "authType": {
          "enum": [
            "none",
            "usernamePassword"
          ]
        },
        "username": {
          "type": "string",
          "maxLength": 255
        }
      },
      "required": [
        "name",
        "host",
        "port",
        "authType",
        "username"
      ],
      "additionalProperties": false
    },
    "Proxy": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "authType": {
          "enum": [
            "none",
            "usernamePassword"
          ]
        },
        "username": {
          "type": "string",
          "maxLength": 255
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "hasPreset": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "host",
        "port",
        "authType",
        "username",
        "id",
        "revision",
        "hasPreset"
      ],
      "additionalProperties": false
    },
    "ProxyItem": {
      "type": "object",
      "properties": {
        "proxy": {
          "$ref": "#/$defs/Proxy"
        },
        "referenceCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        }
      },
      "required": [
        "proxy",
        "referenceCount"
      ],
      "additionalProperties": false
    },
    "ProxyList": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "maxLength": 256
        },
        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "ProxyPage": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProxyItem"
          },
          "maxItems": 100
        },
        "catalogRevision": {
          "$ref": "#/$defs/Revision"
        },
        "nextCursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "items",
        "catalogRevision",
        "nextCursor"
      ],
      "additionalProperties": false
    },
    "ProxySave": {
      "type": "object",
      "properties": {
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "proxyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "configuration": {
          "$ref": "#/$defs/ProxyConfiguration"
        }
      },
      "required": [
        "operationId",
        "configuration"
      ],
      "additionalProperties": false
    },
    "ProxySaved": {
      "type": "object",
      "properties": {
        "proxy": {
          "$ref": "#/$defs/Proxy"
        },
        "catalogRevision": {
          "$ref": "#/$defs/Revision"
        }
      },
      "required": [
        "proxy",
        "catalogRevision"
      ],
      "additionalProperties": false
    },
    "ProxyRemove": {
      "type": "object",
      "properties": {
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "proxyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "operationId",
        "proxyId",
        "expectedRevision"
      ],
      "additionalProperties": false
    },
    "ProxyRemoved": {
      "type": "object",
      "properties": {
        "deleted": {
          "enum": [
            true
          ]
        },
        "catalogRevision": {
          "$ref": "#/$defs/Revision"
        }
      },
      "required": [
        "deleted",
        "catalogRevision"
      ],
      "additionalProperties": false
    },
    "ProxyOperation": {
      "type": "object",
      "properties": {
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "operationId"
      ],
      "additionalProperties": false
    },
    "ProxyOperationResult": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "unknown"
              ]
            }
          },
          "required": [
            "status"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "committed"
              ]
            },
            "result": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ProxySaved"
                },
                {
                  "$ref": "#/$defs/ProxyRemoved"
                }
              ]
            }
          },
          "required": [
            "status",
            "result"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "x-methods": {
    "proxies.catalog.list": "ProxyList",
    "proxies.catalog.save": "ProxySave",
    "proxies.catalog.remove": "ProxyRemove",
    "proxies.catalog.operation": "ProxyOperation"
  },
  "x-results": {
    "proxies.catalog.list": "ProxyPage",
    "proxies.catalog.save": "ProxySaved",
    "proxies.catalog.remove": "ProxyRemoved",
    "proxies.catalog.operation": "ProxyOperationResult"
  }
}
