{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Scope": {
      "type": "object",
      "properties": {
        "workspaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "workspaceGeneration": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "workspaceId",
        "workspaceGeneration"
      ],
      "additionalProperties": false
    },
    "RemotePath": {
      "type": "object",
      "properties": {
        "bytesBase64": {
          "type": "string",
          "minLength": 4,
          "maxLength": 5464,
          "pattern": "^[A-Za-z0-9+/]*={0,2}$"
        }
      },
      "required": [
        "bytesBase64"
      ],
      "additionalProperties": false
    },
    "Evidence": {
      "type": "object",
      "properties": {
        "pid": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,9}$"
        },
        "start": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "maxLength": 20
        },
        "uid": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "maxLength": 20
        },
        "mountNamespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "rootDevice": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "maxLength": 20
        },
        "rootInode": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "maxLength": 20
        }
      },
      "required": [
        "pid",
        "start",
        "uid",
        "mountNamespace",
        "rootDevice",
        "rootInode"
      ],
      "additionalProperties": false
    },
    "Source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "generation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "viewId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      },
      "required": [
        "id",
        "generation",
        "viewId",
        "title"
      ],
      "additionalProperties": false
    },
    "Register": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "viewId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "pty": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "generation": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "id",
            "generation"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "scope",
        "viewId",
        "pty"
      ],
      "additionalProperties": false
    },
    "Registered": {
      "type": "object",
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sourceGeneration": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "sourceId",
        "sourceGeneration"
      ],
      "additionalProperties": false
    },
    "Report": {
      "type": "object",
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sourceGeneration": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "reportSequence": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "maxLength": 20
        },
        "status": {
          "enum": [
            "unknown",
            "ready",
            "lastConfirmed",
            "unmappable",
            "unsupported",
            "disconnected"
          ]
        },
        "logicalPath": {
          "$ref": "#/$defs/RemotePath"
        },
        "physicalPath": {
          "$ref": "#/$defs/RemotePath"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        }
      },
      "required": [
        "sourceId",
        "sourceGeneration",
        "reportSequence",
        "status"
      ],
      "additionalProperties": false
    },
    "Reported": {
      "type": "object",
      "properties": {
        "accepted": {
          "type": "boolean"
        },
        "sourceRevision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "maxLength": 20
        }
      },
      "required": [
        "accepted",
        "sourceRevision"
      ],
      "additionalProperties": false
    },
    "Unregister": {
      "type": "object",
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sourceGeneration": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "sourceId",
        "sourceGeneration"
      ],
      "additionalProperties": false
    },
    "Accepted": {
      "type": "object",
      "properties": {
        "accepted": {
          "type": "boolean"
        }
      },
      "required": [
        "accepted"
      ],
      "additionalProperties": false
    },
    "Directory": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/Source"
            },
            {
              "type": "null"
            }
          ]
        },
        "selectionRevision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "maxLength": 20
        },
        "pathRevision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "maxLength": 20
        },
        "status": {
          "enum": [
            "unknown",
            "ready",
            "lastConfirmed",
            "unmappable",
            "unsupported",
            "disconnected"
          ]
        },
        "logicalPath": {
          "anyOf": [
            {
              "$ref": "#/$defs/RemotePath"
            },
            {
              "type": "null"
            }
          ]
        },
        "physicalPath": {
          "anyOf": [
            {
              "$ref": "#/$defs/RemotePath"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/Evidence"
            },
            {
              "type": "null"
            }
          ]
        },
        "observedAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "scope",
        "source",
        "selectionRevision",
        "pathRevision",
        "status",
        "logicalPath",
        "physicalPath",
        "evidence",
        "observedAt"
      ],
      "additionalProperties": false
    },
    "ConnectionRequest": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sourceGeneration": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "scope",
        "sourceId",
        "sourceGeneration"
      ],
      "additionalProperties": false
    },
    "SourceConnection": {
      "type": "object",
      "properties": {
        "connectionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "connectionId",
        "generation"
      ],
      "additionalProperties": false
    }
  },
  "x-methods": {
    "directories.register": "Register",
    "directories.report": "Report",
    "directories.unregister": "Unregister",
    "directories.connection": "ConnectionRequest"
  },
  "x-results": {
    "directories.register": "Registered",
    "directories.report": "Reported",
    "directories.unregister": "Accepted",
    "directories.connection": "SourceConnection"
  }
}
