{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SoDeck",
  "version": "1.0.1",
  "identifier": "com.sshworkspace.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "dragDropEnabled": true,
        "title": "SoDeck",
        "width": 1360,
        "height": 860,
        "minWidth": 860,
        "minHeight": 580
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost",
      "capabilities": [
        "desktop",
        "terminal-clipboard",
        "history-clipboard"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhEQzU3RTM1QjY5ODA1OEUKUldTT0JaaTJOWDdGaldPRzloM2k0bHM4bXdYN3djWU9VbFhqdytjN2FrSGtkcVhqcjFaSVdqcWsK",
      "endpoints": [
        "https://github.com/BgaSol/soDeck/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true
    }
  }
}
