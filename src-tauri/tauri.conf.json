{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SoDeck",
  "version": "0.5.1",
  "identifier": "com.bgasol.sodeck",
  "build": {
    "beforeDevCommand": "npm run web:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run web:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SoDeck",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480,
        "decorations": false,
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; frame-src 'self' sodeck-plugin: http://sodeck-plugin.localhost https://sodeck-plugin.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "SoDeck remote server workbench",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhEQzU3RTM1QjY5ODA1OEUKUldTT0JaaTJOWDdGaldPRzloM2k0bHM4bXdYN3djWU9VbFhqdytjN2FrSGtkcVhqcjFaSVdqcWsK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
