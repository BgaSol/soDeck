{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SoDeck Update QA Probe",
  "version": "0.1.0",
  "identifier": "com.sodeck.v2.qa.update-probe",
  "build": { "frontendDist": "web" },
  "app": { "windows": [] },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["../../../apps/desktop/src-tauri/icons/icon.ico"],
    "windows": {
      "allowDowngrades": false,
      "nsis": { "installMode": "currentUser", "displayLanguageSelector": false }
    }
  },
  "plugins": { "updater": { "pubkey": "", "requireSignedVersion": true, "windows": { "installMode": "quiet" } } }
}
