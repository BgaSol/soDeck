{
  "name": "sodeck",
  "private": true,
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "web:dev": "vite",
    "web:build": "tsc && vite build",
    "check": "tsc && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "plugin:check": "cargo fmt --manifest-path plugins/terminal/Cargo.toml -- --check && cargo fmt --manifest-path plugins/files/Cargo.toml -- --check && cargo fmt --manifest-path plugins/network-proxy/Cargo.toml -- --check && cargo fmt --manifest-path plugins/system-status/Cargo.toml -- --check && cargo fmt --manifest-path plugins/docker/Cargo.toml -- --check",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml --features test-fixtures --locked",
    "glib:test": "cargo test --manifest-path vendor/glib/Cargo.toml --release --locked --test variant_str_iter",
    "scripts:test": "node --test scripts/*.test.mjs",
    "ui:test": "node scripts/test-server-ui.mjs && node scripts/test-workspace-ui.mjs && node scripts/test-connection-ui.mjs && npm run layout:test && npm run interactions:test && npm run ui:production:test && npm run desktop:test && npm run settings:test",
    "interactions:test": "node --test scripts/test-workbench-interactions.mjs",
    "layout:test": "node scripts/test-workbench-layout.mjs",
    "desktop:test": "npm ci --prefix plugins/terminal --ignore-scripts && node scripts/test-desktop-ui.mjs",
    "ui:production:test": "npm run web:build && node scripts/test-production-ui.mjs",
    "ssh:test": "node scripts/test-openssh.mjs",
    "terminal:test": "node scripts/test-openssh.mjs --terminal",
    "terminal:input:test": "npm ci --prefix plugins/terminal --ignore-scripts && node scripts/test-terminal-input.mjs",
    "network:test": "node scripts/test-openssh.mjs --network",
    "network:netem": "node scripts/test-network-netem.mjs",
    "files:test": "node scripts/test-openssh.mjs --files",
    "plugin:build": "node scripts/package-plugin.mjs",
    "settings:test": "node scripts/test-settings-ui.mjs",
    "system-status:test": "node scripts/test-openssh.mjs --system-status",
    "communication:test": "node scripts/test-component-communication.mjs",
    "system-status:ui:test": "node scripts/test-system-status-ui.mjs",
    "docker:test": "node scripts/test-docker.mjs",
    "docker:process:test": "node scripts/test-docker-process.mjs",
    "docker:ui:test": "node scripts/test-docker-ui.mjs",
    "docker:package:test": "node scripts/test-docker-package.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "playwright": "1.65.0",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  },
  "dependencies": {
    "@floating-ui/dom": "1.8.0",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "markdown-it": "15.0.3"
  },
  "type": "module"
}
