{
  "name": "sodeck",
  "private": true,
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "web:dev": "vite",
    "web:build": "tsc && vite build",
    "check": "tsc && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check && cargo fmt --manifest-path plugins/hello/Cargo.toml -- --check",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml --features test-fixtures --locked",
    "plugin:build": "node scripts/package-plugin.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.4"
  },
  "type": "module"
}
