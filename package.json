{
  "name": "sodeck",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "icons": "tauri icon src-tauri/icons/source.svg --output src-tauri/icons",
    "desktop": "tauri dev",
    "test": "vitest run",
    "test:connection": "playwright test --config playwright.connection.config.ts",
    "test:port-forwarding": "playwright test --config playwright.port-forwarding.config.ts",
    "test:database": "playwright test --config playwright.database.config.ts",
    "test:logs": "playwright test --config playwright.logs.config.ts",
    "test:terminal-history": "playwright test --config playwright.terminal-history.config.ts",
    "test:transfers": "playwright test --config playwright.transfers.config.ts",
    "test:desktop": "playwright test",
    "test:settings": "playwright test --config playwright.settings.config.ts",
    "test:tree": "playwright test --config playwright.file-tree.config.ts",
    "test:resources": "playwright test --config playwright.resources.config.ts",
    "test:mounts": "playwright test --config playwright.mounts.config.ts",
    "test:docker": "playwright test --config playwright.docker.config.ts",
    "test:netbird": "playwright test --config playwright.netbird.config.ts",
    "test:terminal-clipboard": "playwright test --config playwright.terminal-clipboard.config.ts",
    "test:terminal-clipboard:native": "node tests/terminal-clipboard-native.mjs",
    "release:prepare": "node scripts/release-version.mjs prepare",
    "release:check": "node scripts/release-version.mjs check",
    "test:release": "node --test scripts/release.test.mjs",
    "test:updates": "playwright test --config playwright.updates.config.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-virtuoso": "^4.18.19"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tauri-apps/cli": "^2.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.0",
    "vite": "^7.2.0",
    "vitest": "^5.0.4"
  }
}
