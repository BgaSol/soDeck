{
  "apiVersion": "2.2",
  "ui": {
    "entry": "ui/index.html",
    "actions": [
      {
        "id": "new-page",
        "title": "新建终端",
        "defaultCreate": true,
        "dataVersion": 1,
        "command": "fixture.create.v1"
      }
    ],
    "views": [
      {
        "id": "files",
        "title": "文件",
        "icon": "folder",
        "container": "sidebar",
        "instancePolicy": "perWorkspace",
        "defaultSide": "left",
        "defaultPinned": true,
        "openOnWorkspace": "reveal",
        "startupOrder": 10
      },
      {
        "id": "editor",
        "title": "文件编辑器",
        "icon": "log",
        "container": "editor",
        "instancePolicy": "perResource"
      },
      {
        "id": "terminal",
        "title": "终端",
        "icon": "terminal",
        "container": "editor",
        "instancePolicy": "multiple",
        "defaultSide": "left",
        "defaultPinned": true,
        "openOnWorkspace": "createOne",
        "startupOrder": 20,
        "createActionId": "new-page"
      },
      {
        "id": "forwarding",
        "title": "网络转发",
        "icon": "network",
        "container": "sidebar",
        "instancePolicy": "perWorkspace",
        "defaultSide": "right",
        "defaultPinned": true,
        "openOnWorkspace": "none",
        "startupOrder": 30
      }
    ]
  },
  "id": "test.workspace-ui",
  "name": "Workspace test fixture",
  "version": "0.0.0",
  "commands": {
    "handlers": [
      "fixture.create.v1"
    ]
  }
}
