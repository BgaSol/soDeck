{
  "pluginId": "sodeck.terminal",
  "version": "0.13.1",
  "requires": {
    "core": ">=2.0.0, <3.0.0",
    "pluginApi": "^6.1.0",
    "capabilities": [
      "servers.v1",
      "connections.v1",
      "remote.pty.v1",
      "resources.v1",
      "storage.v1",
      "workspace.v4",
      "clipboard.v1",
      "ui.presentation.v1",
      "core.state.v1",
      "workspace.directory.v1",
      "workspace.presentation.v1",
      "remote.pty.observe.v1",
      "remote.pty.start.v1",
      "remote.files.read.v1",
      "remote.exec.v1",
      "connections.observe.v1",
      "ui.theme.live.v1",
      "ui.theme.catalog.v1",
      "ui.theme.dopamine.v1",
      "workspace.contributions.v2",
      "plugins.metadata.v1",
      "observability.events.v2",
      "observability.context.v1",
      "observability.snapshots.v1",
      "observability.metrics.v1",
      "settings.contributions.v1",
      "storage.preferences.v1",
      "ui.settings.v1",
      "connections.route.v2",
      "connections.diagnostics.v1",
      "ui.connectionDiagnostics.v1",
      "auth.ssh.confirm.v1",
      "runtime.clock.v1"
    ],
    "platforms": [
      "windows"
    ]
  },
  "entry": {
    "ui": "ui/index.html",
    "worker": "worker/main.js"
  },
  "contributes": {
    "commands": [
      {
        "id": "terminal.new",
        "title": "新建终端",
        "scope": "server",
        "primary": true
      },
      {
        "id": "terminal.rename",
        "title": "修改显示名称",
        "scope": "view",
        "primary": false,
        "input": {
          "kind": "text",
          "key": "title",
          "label": "显示名称",
          "initial": "viewTitle",
          "minLength": 1,
          "maxLength": 80
        }
      },
      {
        "id": "terminal.reconnect",
        "title": "重新连接",
        "scope": "view",
        "primary": false
      }
    ],
    "workspaceEntries": [],
    "views": [
      {
        "id": "terminal.session",
        "title": "终端",
        "scope": "server",
        "supportedHosts": [
          "tab",
          "window"
        ],
        "dockEdges": [],
        "defaultLocation": {
          "host": "tab"
        },
        "multiple": true,
        "stateVersion": 1,
        "minWidth": 320,
        "minHeight": 160,
        "contextProviders": [
          "directory"
        ]
      }
    ],
    "retiredViews": [
      "terminal.sessions"
    ],
    "workspaceInitializers": [
      {
        "id": "terminal.initial",
        "commandId": "terminal.new"
      }
    ],
    "presentation": {
      "tools": [],
      "tabCreate": [
        {
          "commandId": "terminal.new",
          "icon": "plus"
        }
      ],
      "dialogs": []
    },
    "settings": {
      "descriptorVersion": 1,
      "path": "settings/settings.json"
    }
  },
  "dataSchemaVersion": 1,
  "displayName": "终端",
  "observability": {
    "descriptorVersion": 1,
    "path": "diagnostics/observability.json"
  }
}
