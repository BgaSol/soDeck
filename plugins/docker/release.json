{
  "id": "sodeck.docker",
  "name": "Docker",
  "description": "浏览远端 Docker 资源树、数据根目录与容器关系，查看日志并维护资源。",
  "icon": "docker",
  "order": 50,
  "apiVersion": "2.0",
  "binary": "sodeck-docker",
  "tagPrefix": "plugin-docker-v",
  "ui": {
    "entry": "ui/index.html",
    "views": [
      {
        "id": "browser",
        "title": "Docker",
        "icon": "docker",
        "container": "sidebar",
        "instancePolicy": "perWorkspace",
        "defaultSide": "right",
        "defaultPinned": true,
        "openOnWorkspace": "none"
      },
      {
        "id": "logs",
        "title": "容器日志",
        "icon": "log",
        "container": "editor",
        "instancePolicy": "perResource",
        "entry": "ui/logs.html"
      }
    ]
  },
  "settings": {
    "schemaVersion": 3,
    "pages": [
      {
        "id": "display",
        "title": "Docker",
        "icon": "docker",
        "viewTypes": [
          "browser",
          "logs"
        ],
        "order": 500,
        "groups": [
          {
            "id": "refresh",
            "title": "读取偏好",
            "fields": [
              {
                "key": "refreshSeconds",
                "title": "资源树刷新间隔",
                "type": "select",
                "default": "5",
                "options": [
                  {
                    "value": "5",
                    "title": "5 秒"
                  },
                  {
                    "value": "10",
                    "title": "10 秒"
                  },
                  {
                    "value": "30",
                    "title": "30 秒"
                  }
                ],
                "apply": "live"
              }
            ]
          }
        ]
      }
    ]
  },
  "icons": {
    "docker": "assets/icons/docker.svg",
    "log": "assets/icons/log.svg"
  }
}
