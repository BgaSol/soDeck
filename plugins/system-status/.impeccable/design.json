  "components": [
    {
      "name": "顶部图标操作",
      "kind": "button",
      "refersTo": "status-action",
      "description": "刷新与暂停，透明紧凑操作，保留可访问名称。",
      "html": "<button class=\"ds-action\" type=\"button\" title=\"刷新\" aria-label=\"刷新\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M20 10a8 8 0 0 0-14-5L3 8m0-5v5h5M4 14a8 8 0 0 0 14 5l3-3m0 5v-5h-5\"/></svg></button>",
      "css": ".ds-action {width:27px;min-height:27px;padding:0;display:grid;place-items:center;border:var(--sd-stroke-control,1px) solid transparent;border-radius:5px;background:transparent;color:var(--muted,#586174);cursor:pointer} .ds-action svg {width:15px;height:15px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round} .ds-action:focus-visible {outline:2px solid var(--accent,#7661d1);outline-offset:2px} .ds-action:disabled {opacity:.5;cursor:default}"
    },
    {
      "name": "接口选择器",
      "kind": "input",
      "refersTo": "interface-select",
      "description": "原生选择器，与网络分组标题并排。",
      "html": "<select class=\"ds-select\" aria-label=\"选择网络接口\"><option>eth0</option><option>eth1</option></select>",
      "css": ".ds-select {font:11px/1.5 system-ui, -apple-system, \"Segoe UI\", sans-serif; color:var(--text,#242936); background:var(--panel,#fff); border:var(--sd-stroke-control,1px) solid var(--border,#dce1eb); border-radius:5px; cursor:pointer; transition:background-color 100ms ease-out;min-width:64px;max-width:100%;padding:2px 5px} .ds-page:hover, .ds-select:hover {background:var(--hover,#eff0f5)} .ds-page:active {background:var(--accent-bg,#f0ecfc)} .ds-page:disabled,.ds-select:disabled {opacity:.5;cursor:default} .ds-page:focus-visible,.ds-select:focus-visible {outline:2px solid var(--accent,#7661d1);outline-offset:2px}"
    },
    {
      "name": "趋势指标",
      "kind": "custom",
      "refersTo": "metric-section",
      "description": "当前读数、五分钟真实折线与时间说明共处一组；预览为静态样本。",
      "html": "<section class=\"ds-trend\"><div class=\"ds-heading\"><h2>CPU</h2><strong>23.4<span>%</span></strong></div><p>8 个逻辑核心</p><svg viewBox=\"0 0 240 48\" preserveAspectRatio=\"none\" tabindex=\"0\" role=\"img\" aria-label=\"CPU 最近五分钟趋势\"><title>静态样本，缺口不连线</title><path class=\"ds-grid\" d=\"M0 2H240 M0 24H240 M0 46H240\"/><path class=\"ds-series\" d=\"M0 35 L22 37 L44 34 L66 36 L84 35 M100 37 L122 23 L140 35 L167 34 L190 36 L217 34 L240 36\"/></svg><div class=\"ds-time\"><span>5 分钟前</span><span>现在</span></div></section>",
      "css": ".ds-trend {font:11px/1.5 system-ui, -apple-system, \"Segoe UI\", sans-serif;font-variant-numeric:tabular-nums;color:var(--text,#242936);padding:6px 0;border-bottom:1px solid color-mix(in srgb,var(--border,#dce1eb) 75%,transparent)} .ds-heading {display:flex;align-items:center;justify-content:space-between;gap:8px} .ds-heading h2 {margin:0;font-size:13px;line-height:1.4;font-weight:650} .ds-heading strong {font-size:25px;line-height:1.15;font-weight:600;letter-spacing:-.025em} .ds-heading strong span {font-size:13px;font-weight:500;letter-spacing:0;margin-left:2px;color:var(--muted,#586174)} .ds-trend p {margin:2px 0 0;color:var(--muted,#586174)} .ds-trend > svg {display:block;width:100%;height:30px;margin-top:5px;fill:none;cursor:crosshair} .ds-grid {stroke:color-mix(in srgb,var(--border,#dce1eb) 45%,transparent);stroke-width:.7;vector-effect:non-scaling-stroke} .ds-series {stroke:var(--terminal-blue,#245b9a);stroke-width:1.6;vector-effect:non-scaling-stroke} .ds-trend > svg:focus-visible {outline:2px solid var(--accent,#7661d1);outline-offset:2px} .ds-time {display:flex;justify-content:space-between;margin-top:2px;line-height:1.2;color:var(--muted,#586174)}"
    },
    {
      "name": "挂载容量",
      "kind": "custom",
      "refersTo": "filesystem-meter",
      "description": "路径、分母、只读容量条和剩余量；注意状态同时显示文字。",
      "html": "<div class=\"ds-filesystem\"><div class=\"ds-fs-top\"><strong>/data</strong><span>286 GiB / 500 GiB</span></div><div class=\"ds-meter\" role=\"meter\" aria-label=\"/data 已用容量\" aria-valuemin=\"0\" aria-valuemax=\"100\" aria-valuenow=\"57.2\"><span style=\"width:57.2%\"></span></div><div class=\"ds-fs-bottom\"><span>可用 214 GiB</span><span>57.2%</span></div></div>",
      "css": ".ds-filesystem {font:11px/1.5 system-ui, -apple-system, \"Segoe UI\", sans-serif;font-variant-numeric:tabular-nums;margin-top:8px;color:var(--muted,#586174)} .ds-fs-top,.ds-fs-bottom {display:flex;justify-content:space-between;flex-wrap:wrap;gap:2px 8px} .ds-fs-top strong {font:600 11px/1.5 Consolas,ui-monospace,monospace;color:var(--text,#242936);overflow-wrap:anywhere;min-width:0} .ds-meter {height:4px;margin:6px 0 5px;background:color-mix(in srgb,var(--border,#dce1eb) 45%,transparent);border-radius:2px;overflow:hidden} .ds-meter > span {height:100%;display:block;background:var(--good,#23734f);border-radius:inherit} .ds-filesystem.ds-warning .ds-meter > span {background:var(--warning,#8a590f)} .ds-filesystem.ds-warning .ds-fs-bottom {color:var(--warning,#8a590f)} @media(forced-colors:active) {.ds-meter > span {background:Highlight}}"
    },
    {
      "name": "按需详情",
      "kind": "custom",
      "refersTo": "detail-summary",
      "description": "原生 details，用箭头和辅助文字引出设备与采集信息。",
      "html": "<details class=\"ds-disclosure\"><summary><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m9 5 7 7-7 7\"/></svg><span>设备信息</span><span class=\"ds-meta\">规格与运行</span></summary><dl><dt>主机名</dt><dd>prod-web-01</dd><dt>逻辑核心</dt><dd>8</dd></dl></details>",
      "css": ".ds-disclosure {font:11px/1.5 system-ui, -apple-system, \"Segoe UI\", sans-serif;color:var(--text,#242936);border-bottom:1px solid color-mix(in srgb,var(--border,#dce1eb) 75%,transparent)} .ds-disclosure > summary {display:flex;align-items:center;gap:7px;min-height:39px;list-style:none;font-size:12px;font-weight:500;cursor:pointer} .ds-disclosure > summary::-webkit-details-marker {display:none} .ds-disclosure svg {width:12px;height:12px;color:var(--muted,#586174);fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;transition:transform 180ms ease-out} .ds-disclosure[open] > summary > svg {transform:rotate(90deg)} .ds-disclosure > summary:focus-visible {outline:2px solid var(--accent,#7661d1);outline-offset:2px} .ds-meta {margin-left:auto;color:var(--muted,#586174);font-size:11px;overflow-wrap:anywhere} .ds-disclosure dl {display:grid;grid-template-columns:minmax(65px,.9fr) minmax(0,1.1fr);gap:9px 12px;margin:0;padding:2px 0 14px 19px} .ds-disclosure dt {color:var(--muted,#586174)} .ds-disclosure dd {margin:0;overflow-wrap:anywhere} @media(prefers-reduced-motion:reduce) {.ds-disclosure svg {transition:none}}"
    }
  ],
  "narrative": {
    "northStar": "技术期刊数据图表",
    "overview": "这份规范仅适用于系统状态插件的 ui/，记录正式实现中的视觉规则。它采用用户确认的“技术期刊数据图表”语言：紧凑、平静，让当前值、近期曲线和辅助说明沿同一连续数据面排列。\n\n宿主提供浅色、深色和多巴胺主题，插件共用结构和指标语义。数据来自当前服务器的实际采样；读取中、不可用、过期与断线各有文字，详情按需展开。",
    "keyCharacteristics": [
      "连续分区，数值、曲线与时间对齐。",
      "三主题继承宿主 token，指标类别保持一致。",
      "保留真实历史与缺口，来源和规格按需展开。"
    ],
    "rules": [
      {
        "name": "The Series Identity Rule",
        "body": "CPU 与接收共享蓝色；内存与发送共享绿色。主题改变颜色值，不改变对应关系。",
        "section": "colors"
      },
      {
        "name": "The Numeric Alignment Rule",
        "body": "读数、容量和时间使用等宽数字；单位退到辅助字号，标题不与当前值争夺权重。",
        "section": "typography"
      },
      {
        "name": "The Continuous Section Rule",
        "body": "状态指标在同一滚动面中以细线分组；层次来自对齐、字阶与间距。",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do 继承宿主三主题的颜色与描边 token，保持曲线和图例的类别对应。",
      "Do 显示明确单位、容量分母和成功采样时间；注意与错误状态同时使用文字。",
      "Do 使用原生 select、details 和只读 meter，保留可访问名称、键盘焦点与减少动态效果设置。"
    ],
    "donts": [
      "Don't 用零值代替未知数据，或用连续线跨过采样缺口。",
      "Don't 用新的数据卡片、阴影或装饰动效替代当前连续分区。",
      "Don't 将原型的独立色值或宿主其他组件规则扩展为本插件规范。"
    ]
  }
}
