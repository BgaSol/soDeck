{
  "id": "sodeck.files",
  "name": "文件",
  "description": "浏览服务器目录、上传下载、管理文件，支持 UTF-8 小文本编辑和草稿导出。",
  "icon": "folder",
  "order": 20,
  "apiVersion": "1",
  "binary": "sodeck-files",
  "tagPrefix": "plugin-files-v",
  "ui": {
    "apiVersion": "2",
    "entry": "ui/index.html",
    "views": [
      {
        "id": "files",
        "title": "文件",
        "icon": "folder",
        "container": "sidebar",
        "instancePolicy": "perWorkspace",
        "defaultSide": "left",
        "defaultPinned": true,
        "openOnWorkspace": "reveal",
        "startupOrder": 10
      },
      {
        "id": "editor",
        "title": "文件编辑器",
        "icon": "log",
        "container": "editor",
        "instancePolicy": "perResource"
      }
    ]
  },
  "settings": {
    "apiVersion": "1",
    "schemaVersion": 1,
    "pages": [
      {
        "id": "browser",
        "title": "文件列表",
        "icon": "folder",
        "viewTypes": [
          "files"
        ],
        "order": 200,
        "groups": [
          {
            "id": "display",
            "title": "列表显示",
            "fields": [
              {
                "key": "followTerminal",
                "title": "跟随活动终端目录",
                "type": "boolean",
                "default": true,
                "apply": "live"
              },
              {
                "key": "showHidden",
                "title": "显示隐藏条目",
                "type": "boolean",
                "default": true,
                "apply": "live"
              },
              {
                "key": "density",
                "title": "列表密度",
                "type": "select",
                "default": "compact",
                "options": [
                  {
                    "value": "compact",
                    "title": "紧凑"
                  },
                  {
                    "value": "comfortable",
                    "title": "舒适"
                  }
                ],
                "apply": "live"
              },
              {
                "key": "fontSize",
                "title": "名称字号",
                "type": "number",
                "default": 12,
                "min": 11,
                "max": 18,
                "step": 1,
                "unit": "px",
                "apply": "live"
              }
            ]
          }
        ]
      },
      {
        "id": "editor",
        "viewTypes": [
          "editor"
        ],
        "fileEditor": true
      }
    ]
  },
  "build": {
    "fileEditor": true
  }
}
