{
  "pluginId": "sodeck.network-proxy",
  "version": "0.6.0",
  "requires": {
    "core": ">=2.0.0, <3.0.0",
    "pluginApi": "^6.1.0",
    "platforms": [
      "windows"
    ],
    "capabilities": [
      "network.tcp.v1",
      "network.stream.v1",
      "network.resources.v1",
      "connections.route.v2",
      "servers.routes.v2",
      "servers.v1",
      "storage.v1",
      "workspace.v4",
      "clipboard.v1",
      "core.state.v1",
      "ui.presentation.v1",
      "workspace.multiplugin.v1",
      "workspace.presentation.v1",
      "ui.theme.live.v1",
      "ui.theme.catalog.v1",
      "ui.theme.dopamine.v1",
      "workspace.contributions.v2",
      "plugins.metadata.v1",
      "ui.dialog.v1",
      "observability.events.v2",
      "observability.context.v1",
      "observability.snapshots.v1",
      "observability.metrics.v1",
      "connections.diagnostics.v1",
      "ui.connectionDiagnostics.v1",
      "auth.ssh.confirm.v1"
    ]
  },
  "entry": {
    "ui": "ui/index.html",
    "worker": "worker/main.js"
  },
  "contributes": {
    "commands": [
      {
        "id": "network.open",
        "title": "网络隧道",
        "scope": "server",
        "primary": false
      },
      {
        "id": "network.start",
        "title": "启动网络规则",
        "scope": "view",
        "primary": false
      },
      {
        "id": "network.reconnect",
        "title": "重新连接网络规则",
        "scope": "view",
        "primary": false
      }
    ],
    "views": [
      {
        "id": "network.manager",
        "title": "网络隧道",
        "scope": "server",
        "supportedHosts": [
          "dock",
          "tab",
          "window"
        ],
        "dockEdges": [
          "left",
          "right"
        ],
        "defaultLocation": {
          "host": "dock",
          "edge": "right"
        },
        "multiple": false,
        "stateVersion": 1,
        "minWidth": 320,
        "minHeight": 240
      }
    ],
    "workspaceEntries": [
      {
        "viewType": "network.manager",
        "openByDefault": false
      }
    ],
    "workspaceInitializers": [],
    "presentation": {
      "tools": [
        {
          "viewType": "network.manager",
          "commandId": "network.open",
          "edge": "right",
          "icon": "arrow-left-right",
          "defaultWidth": 360
        }
      ],
      "tabCreate": [],
      "dialogs": [
        {
          "id": "network.rule-editor",
          "title": "创建网络隧道",
          "width": 560,
          "height": 520
        }
      ]
    }
  },
  "dataSchemaVersion": 1,
  "displayName": "网络隧道",
  "observability": {
    "descriptorVersion": 1,
    "path": "diagnostics/observability.json"
  }
}
